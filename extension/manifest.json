{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.2.9",
  "default_locale": "zh_CN",
  "description": "__MSG_appDesc__",
  "offline_enabled": true,
  "homepage_url": "https://523649015.github.io/Ddayup/",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "sidePanel",
    "webRequest",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "cookies",
    "clipboardWrite",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["http://127.0.0.1:3000/*", "http://localhost:3000/*", "https://mingmingchuangyi.cn/*", "https://*.mingmingchuangyi.cn/*"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionDefaultTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "sandbox": {
    "pages": ["sandbox-model.html"]
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:3000/*", "http://localhost:3000/*"],
      "js": ["detect.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mingmingchuangyi.cn/*", "https://*.mingmingchuangyi.cn/*"],
      "js": ["site-auth-bridge.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.youtube.com/*",
        "*://*.douyin.com/*",
        "*://*.iesdouyin.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": ["inject-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.youtube.com/*",
        "*://*.douyin.com/*",
        "*://*.iesdouyin.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": ["rescan-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["model-api-capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://pan.xunlei.com/*", "*://*.xunlei.com/*"],
      "js": ["xunlei-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["*://*.doubao.com/*"],
      "js": ["doubao-audio-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
