{
  "name": "DDUp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api": "node --watch server/hmdao-api.mjs",
    "serve:3000": "node server/ui-static-proxy.mjs --port 3000 --api http://127.0.0.1:8792",
    "dev:full": "node server/dev-full.mjs",
    "dev:full:real": "node server/dev-full.mjs --real-api",
    "verify:terminal": "node server/verify-terminal-flow.mjs",
    "verify:workflow-ws": "node server/verify-workflow-ws.mjs",
    "verify:image-analysis-smoke": "node server/verify-local-image-analysis-smoke.mjs",
    "verify:dcc": "node server/verify-dcc-flow.mjs",
    "verify:dcc-environment-panel": "node server/verify-dcc-environment-panel.mjs",
    "dcc:diagnose": "node ../scripts/dcc/diagnose-dcc.mjs",
    "verify:dcc-browser": "node server/verify-dcc-browser-flow.mjs",
    "verify:dcc-video-tagging": "node server/verify-dcc-video-tagging-flow.mjs",
    "verify:dcc-browser:keep-open": "node server/verify-dcc-browser-flow.mjs --visible --keep-open",
    "verify:browser": "node scripts/verify-browser-flow.mjs",
    "verify:browser:full": "node -e \"process.env.HMDAO_VERIFY_FULL_TOOL_CHAIN='1'; import('./scripts/verify-browser-flow.mjs').then((m)=>m.main())\"",
    "verify:post-browser": "node server/verify-post-browser-flow.mjs",
    "verify:tagging-contract": "node server/verify-tagging-contract-preview.mjs",
    "verify:browser:visible": "node scripts/verify-browser-visible-flow.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/prune-dist-wasm.mjs",
    "update-browserslist-db": "update-browserslist-db@latest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "mcp": "node server/mcp/index.mjs",
    "test:mcp": "node ../scripts/test-mcp-memory.mjs",
    "test:auth": "node ../scripts/verify-bcf-logic.mjs && node ../scripts/verify-gij-logic.mjs && node ../scripts/verify-lmn-logic.mjs",
    "test:gate": "node ../scripts/run-decision-gate.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
