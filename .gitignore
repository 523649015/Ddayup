# 部署脚本产生的日志（本机）
.deploy-dist-log.txt
.deploy-log.txt

# Edge 加载项「一键更新」工具目录需要入库。
# 注意：上方第 14 行的通用规则 `tools/` 会把 extension/tools/ 整个目录排除，
# 导致一键更新脚本与文档丢失，故在此显式放行该目录及其内容。
!extension/tools/
!extension/tools/*
# API 凭证（与「一键打包」无关，单独分类存储，绝不入库）
extension/tools/edge-api-config.ps1
extension/tools/.env

# 扩展大二进制 / 构建产物（Node 运行时副本 91MB、打包 exe 37MB、录像产物 79MB —— 绝不入库）
extension/*.zip
extension/native-host/*.exe
extension/native-host/*.blob
extension/native-host/*.bin
extension/native-host/*.txt
extension/demo-recorder/output/

# 部署/构建产物打包（app-deploy.tar.gz 22GB、ddayup-*.tar.gz 等，均可由 npm run build + tar 重建，绝不入库）
*.tar.gz
# 遗留无版本 ort-wasm（实际运行已切到 /ort-wasm-v1/，见 app/src/services/localInference/ortEnv.ts）
app/public/ort-wasm/
# 支付/接口证书与私钥（含微信支付 apiclient_key.pem 真实私钥，绝不入库）
app/server/certs/
